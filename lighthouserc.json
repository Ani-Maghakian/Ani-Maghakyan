{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/lighthouse-server.mjs",
      "startServerReadyPattern": "Lighthouse compressed server ready",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/en/",
        "http://127.0.0.1:4173/services/screenwriting/",
        "http://127.0.0.1:4173/projects/elens-diary/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "maxWaitForLoad": 90000,
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 1 }],
        "categories:accessibility": ["warn", { "minScore": 1 }],
        "categories:best-practices": ["warn", { "minScore": 1 }],
        "categories:seo": ["warn", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
